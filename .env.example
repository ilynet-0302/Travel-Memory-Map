DATABASE_USERNAME=travel_memory
DATABASE_PASSWORD=travel_memory
SUPABASE_AUTH_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URI=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWS_ALGORITHMS=ES256
